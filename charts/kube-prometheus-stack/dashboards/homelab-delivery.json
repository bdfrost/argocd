                        "text": "Synced",
                        "color": "green",
                        "index": 0
                      },
                      "OutOfSync": {
                        "text": "OutOfSync",
                        "color": "orange",
                        "index": 1
                      },
                      "Unknown": {
                        "text": "Unknown",
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
