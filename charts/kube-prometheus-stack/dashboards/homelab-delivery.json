                        "index": 0
                      },
                      "Progressing": {
                        "text": "Progressing",
                        "color": "blue",
                        "index": 1
                      },
                      "Degraded": {
                        "text": "Degraded",
                        "color": "red",
                        "index": 2
                      },
                      "Missing": {
                        "text": "Missing",
                        "color": "orange",
                        "index": 3
                      },
                      "Suspended": {
                        "text": "Suspended",
                        "color": "text",
                        "index": 4
                      },
