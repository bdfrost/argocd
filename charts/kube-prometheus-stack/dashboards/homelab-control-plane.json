      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({namespace=\"kube-system\", pod=\"etcd-k8s-c1\"} |~ \"slow fdatasync|took too long\" [5m]))",
