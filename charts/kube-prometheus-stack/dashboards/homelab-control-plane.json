    {
      "type": "timeseries",
      "title": "k8s-c1 disk write latency and busy time",
      "description": "From node-exporter inside the k8s-c1 VM. Write latency is seconds per write; busy is the fraction of time the disk had I/O in flight.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(rate(node_disk_write_time_seconds_total[5m]) / rate(node_disk_writes_completed_total[5m])) * on(instance) group_left(nodename) node_uname_info{nodename=\"k8s-c1\"}",
          "legendFormat": "avg write latency {{device}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_disk_io_time_seconds_total[5m]) * on(instance) group_left(nodename) node_uname_info{nodename=\"k8s-c1\"}",
          "legendFormat": "busy {{device}} (0-1)"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      }
    },
