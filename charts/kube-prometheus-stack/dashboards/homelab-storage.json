    {
      "type": "bargauge",
      "title": "Volume used",
      "description": "Per DSM volume. The storage pool itself shows as almost full because the volumes are carved out of it; that's normal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(1 - raidFreeSize{job=\"synology\", raidName=~\"Volume.*\"} / raidTotalSize{job=\"synology\", raidName=~\"Volume.*\"}) * 100",
          "legendFormat": "{{raidName}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 23
      }
    },
