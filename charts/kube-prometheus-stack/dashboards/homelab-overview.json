    {
      "type": "stat",
      "title": "Error log lines (15m)",
      "description": "Lines that look like errors across all pods. Breakdown in Homelab / Logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
