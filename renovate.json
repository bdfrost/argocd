{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.*\\.ya?ml$/",
      "/^charts\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Keep Plex image updates separate and reviewable",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "groupName": "Plex image",
      "separateMajorMinor": true,
      "automerge": false,
      "labels": ["dependencies", "plex"]
    }
  ]
}
