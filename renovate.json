{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.*\\.ya?ml$/",
      "/^charts\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Plex image: pms-docker tags end in a per-release git hash (e.g. -cb3ebc72d), which the docker versioning scheme treats as an incompatible suffix — it silently drops every update. Regex versioning matches only the plain <ver>-<hash> tags (not -arm64/-amd64/-armhf) and ranks them correctly.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker", "index.docker.io/plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-(?<prerelease>[a-f0-9]{7,40})$",
      "groupName": "Plex image",
      "separateMajorMinor": true,
      "labels": ["dependencies", "plex"]
    },
    {
      "description": "Automerge patch/minor/digest bumps via GitHub native automerge",
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Majors stay manual for review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
