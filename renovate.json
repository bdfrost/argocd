{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps\\/.*\\.ya?ml$/",
      "/^charts\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Keep Plex image updates in their own grouped, labeled MRs (automerged like other patch/minor since 2026-09-14)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "groupName": "Plex image",
      "separateMajorMinor": true,
      "labels": ["dependencies", "plex"]
    },
    {
      "description": "Automerge patch/minor/digest bumps via GitHub native automerge",
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Majors stay manual for review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
