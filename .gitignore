# OS / editor cruft
.DS_Store

# Local script/tool output
*.log
__pycache__/

# kubectl cache (contains cluster address/API discovery; never commit)
.kube/

# Chart dependencies fetched by `helm dependency build`. ArgoCD fetches the version pinned in
# each Chart.lock itself; a committed tgz overrides that silently, so Renovate bumps never deploy.
charts/*/charts/*.tgz
